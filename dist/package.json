{
    "name": "n8n-nodes-drupal",
    "version": "0.1.11",
    "description": "Community node for Drupal",
    "license": "MIT",
    "homepage": "",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Stephen Mulvihill",
        "email": "smulvih2@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cinders-io/n8n-nodes-drupal.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release:rc": "npm run build && npm version prerelease --preid=rc --no-git-tag-version && npm publish --tag rc",
        "release:stable": "npm run build && npm version patch --no-git-tag-version && npm publish"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/DrupalApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Drupal/Drupal.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "overrides": {
        "change-case": "4.1.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
